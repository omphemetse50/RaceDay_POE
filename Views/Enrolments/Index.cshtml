@model List<ApiEnrolment>
@{
    ViewData["Title"] = "My Enrolments";
}

<h1>My Enrolments</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You haven't enrolled in any events yet. <a asp-controller="Events" asp-action="Index">Browse upcoming events</a>.
    </div>
}
else
{
    <table class="table table-hover bg-white rounded">
        <thead>
            <tr>
                <th>Event</th>
                <th>Category</th>
                <th>Enrolled on</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var en in Model.OrderByDescending(e => e.EnrolmentDate))
            {
                <tr>
                    <td><a asp-controller="Events" asp-action="Details" asp-route-id="@en.EventId">@en.EventName</a></td>
                    <td>@en.CategoryName</td>
                    <td>@en.EnrolmentDate.ToString("dd MMM yyyy")</td>
                    <td><span class="status-badge @StatusBadgeHelper.CssClass(en.Status)">@en.Status</span></td>
                    <td>
                        <form asp-controller="Enrolments" asp-action="Cancel" method="post" onsubmit="return confirm('Cancel this enrolment?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="enrolmentId" value="@en.EnrolmentId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
