@model ApiEvent
@{
    ViewData["Title"] = Model.Name;
    var myUserId = User.Identity?.IsAuthenticated == true
        ? int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value)
        : (int?)null;
    var isOwner = myUserId.HasValue && Model.OrganiserId == myUserId.Value;
}

@if (!string.IsNullOrEmpty(Model.BannerImageUrl))
{
    <img src="@Model.BannerImageUrl" class="w-100 mb-4" style="max-height:320px;object-fit:cover;border-radius:0.75rem;" alt="@Model.Name banner" />
}

<div class="d-flex justify-content-between align-items-start flex-wrap">
    <div>
        <h1>@Model.Name</h1>
        <p class="text-muted">
            📍 @Model.Location &nbsp;|&nbsp; 📅 @Model.EventDate.ToString("dddd, dd MMMM yyyy 'at' HH:mm")
            &nbsp;|&nbsp; 📏 @Model.DistanceKm km &nbsp;|&nbsp; 🏷️ @Model.EventType
        </p>
        <p class="text-muted">Organised by @Model.OrganiserName</p>
    </div>

    @if (isOwner)
    {
        <div class="btn-group">
            <a asp-controller="Events" asp-action="Edit" asp-route-id="@Model.EventId" class="btn btn-outline-primary">Edit Event</a>
            <a href="/Categories?eventId=@Model.EventId" class="btn btn-outline-primary">Manage Categories</a>
            <a asp-controller="Events" asp-action="Enrolments" asp-route-id="@Model.EventId" class="btn btn-outline-primary">View Enrolments</a>
            <form asp-controller="Events" asp-action="Delete" asp-route-id="@Model.EventId" method="post" onsubmit="return confirm('Delete this event? This cannot be undone.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">Delete</button>
            </form>
        </div>
    }
</div>

<p class="mt-3">@Model.Description</p>

<hr class="my-4" />

<h3>Categories</h3>
@if (!Model.Categories.Any())
{
    <p class="text-muted">No categories have been added for this event yet.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-3">
        @foreach (var cat in Model.Categories)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@cat.Name</h5>
                        <p class="card-text text-muted">
                            @(cat.DistanceKm.HasValue ? $"{cat.DistanceKm} km" : "Age-based category")
                            &middot; Max @cat.MaxParticipants participants
                        </p>

                        @if (User.IsInRole("Participant"))
                        {
                            <form asp-controller="Enrolments" asp-action="Enrol" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="categoryId" value="@cat.CategoryId" />
                                <input type="hidden" name="eventId" value="@Model.EventId" />
                                <button type="submit" class="btn btn-primary w-100">Enter this category</button>
                            </form>
                        }
                        else if (!User.Identity!.IsAuthenticated)
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary w-100">Log in to enter</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
