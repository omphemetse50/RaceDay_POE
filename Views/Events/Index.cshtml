@model EventListFilterViewModel
@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>🏁 Upcoming RaceDay Events</h1>
    @if (User.IsInRole("Organiser"))
    {
        <a asp-controller="Events" asp-action="Create" class="btn btn-primary">+ Create Event</a>
    }
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-5">
        <input type="text" name="location" value="@Model.Location" class="form-control" placeholder="Filter by location (e.g. Gauteng)" />
    </div>
    <div class="col-md-4">
        <input type="date" name="afterDate" value="@Model.AfterDate?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
    </div>
</form>

@if (!Model.Events.Any())
{
    <div class="alert alert-info">No events found. Check back soon!</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var ev in Model.Events.OrderBy(e => e.EventDate))
        {
            var typeClass = ev.EventType.ToLower() switch
            {
                "run" => "badge-run",
                "walk" => "badge-walk",
                "cycle" => "badge-cycle",
                _ => "badge-secondary"
            };
            <div class="col">
                <div class="card event-card h-100">
                    @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                    {
                        <img src="@ev.BannerImageUrl" class="card-img-top" alt="@ev.Name banner" />
                    }
                    else
                    {
                        <div class="card-img-top d-flex align-items-center justify-content-center text-muted">No banner image</div>
                    }
                    <div class="card-body">
                        <span class="badge badge-event-type @typeClass mb-2">@ev.EventType</span>
                        <h5 class="card-title">@ev.Name</h5>
                        <p class="card-text text-muted mb-1">📍 @ev.Location</p>
                        <p class="card-text text-muted mb-1">📅 @ev.EventDate.ToString("dd MMM yyyy")</p>
                        <p class="card-text text-muted">📏 @ev.DistanceKm km</p>
                        <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventId" class="btn btn-outline-primary w-100">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
