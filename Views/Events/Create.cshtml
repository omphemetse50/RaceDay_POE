@model EventFormViewModel
@{
    ViewData["Title"] = "Create Event";
}

<h1>Create a new event</h1>

<form asp-controller="Events" asp-action="Create" method="post" enctype="multipart/form-data" class="mt-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_EventFormFields" />
    <button type="submit" class="btn btn-primary mt-3">Create Event</button>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary mt-3">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
